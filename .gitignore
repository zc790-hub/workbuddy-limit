# ── 依赖 / 虚拟环境（不要提交） ──────────────────────────────
.venv/
vendor/
node_modules/
__pycache__/
*.py[cod]

# ── 运行产物 ────────────────────────────────────────────────
app.log
*.bak
*.bak.*

# ── 登录态与缓存：绝对不要提交 ───────────────────────────────
# 正常运行时这些在 ~/.workbuddy-limit/（项目目录外），
# 这里再加一层保险，防止有人复制进来后被误提交。
.workbuddy-limit/
profile/
cookies*.txt
credits-cache.json
*-menubar.json

# ── 系统杂物 ────────────────────────────────────────────────
.DS_Store
